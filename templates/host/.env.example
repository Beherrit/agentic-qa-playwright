# Copy to .env (ignored by git). Everything here is optional; the values in qa.config.json are the defaults.

# Where the app answers, when it is not the address in qa.config.json (a local build, a preview).
BASE_URL=

# Which test account the suite signs in as, when the app has several (personas.envVar in qa.config.json names
# the variable the suite reads; QA_PERSONA is the default name).
QA_PERSONA=

# The pipeline's agents, when run from this machine rather than CI. One of these, or sign in with the Claude Code
# CLI once. In CI they live in the POC environment's secrets, never in a file.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
