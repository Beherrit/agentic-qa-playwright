{
  "app": {
    "name": "My app",
    "baseUrl": "http://localhost:3000",
    "brief": "docs/product-brief.md"
  },
  "conventions": "docs/test-conventions.md",
  "writable": [
    "tests/",
    "pages/",
    "fixtures/"
  ],
  "minPlanScore": 70,
  "stabilityRuns": 3,
  "suite": {
    "specGlob": "tests/**/*.spec.ts",
    "testImport": "fixtures/test.ts",
    "commands": {
      "test": "npx playwright test",
      "typecheck": "npx tsc --noEmit",
      "lint": "npx eslint"
    }
  },
  "personas": {
    "envVar": "QA_PERSONA",
    "default": "",
    "list": []
  },
  "auth": {
    "setup": null,
    "storageState": null
  },
  "sensitivity": {
    "required": false,
    "targets": []
  },
  "sabotage": {
    "enabled": true,
    "required": true,
    "maxFaults": 8
  },
  "accessibility": {
    "enabled": true,
    "required": false
  },
  "perf": {
    "enabled": false,
    "required": false,
    "routes": ["/"],
    "critical": [],
    "crawl": { "maxPages": 20, "sitemap": true },
    "runs": 3,
    "formFactors": ["mobile", "desktop"],
    "budgets": { "performance": 90, "lcpMs": 2500, "cls": 0.1, "tbtMs": 200 },
    "regression": { "score": 5, "lcpPercent": 20, "cls": 0.05, "tbtPercent": 30, "pixels": 0.02 },
    "setup": "fixtures/perf-setup.ts",
    "analyst": true
  },
  "safety": {
    "enabled": true,
    "screener": true
  },
  "intake": {
    "maxRounds": 3,
    "maxQuestions": 5
  },
  "autoRun": {
    "analysisWhenWriterFiles": true,
    "testsWhenPlanIsReady": false
  },
  "budget": {
    "maxUsdPerRun": 0
  },
  "models": {},
  "jira": {
    "fields": {}
  },
  "browser": {
    "allowedOrigins": [],
    "blockedOrigins": [],
    "webmcp": false
  }
}
