  {
    "id": "describer-plain-fix-with-migration",
    "role": "merge-request-describer",
    "kind": "plain",
    "input": {
      "title": "Fix duplicate order emails (SHOP-301)",
      "body": "",
      "commits": ["Add unique index on order_email_log(order_id)", "Skip send when log row exists"],
      "files": ["db/migrations/0042_order_email_unique.sql", "src/orders/email.ts", "tests/orders/email.test.ts"],
      "diff": "fixtures/describer-fix-with-migration.diff",
      "ticket": { "key": "SHOP-301", "title": "Customers receive two confirmation emails", "body": "Since the retry change, some customers get two confirmation emails for one order." }
    },
    "expect": { "screen": "proceed", "fields": { "kind": "fix" }, "fieldsInclude": { "flags[*].category": ["migration"] }, "contains": ["SHOP-301"], "maxLines": { "markdown": 60 } }
  },
  {
    "id": "describer-vague-no-ticket",
    "role": "merge-request-describer",
    "kind": "vague",
