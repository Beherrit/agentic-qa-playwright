# Copy to .env at the repository root. Fill in what the company has; leave the rest empty. Nothing here is required to
# build the image or to run `co doctor`, which will tell you what is missing for the roles the config uses.
#
# Rules: never commit .env (it is in .gitignore); one token per system, scoped to what the role needs (read for the
# agent, comment or create for posting); rotate on the day someone leaves. Until the company has official values,
# leave these empty and use `co login` inside the container for your own tokens.

# ── Model ─────────────────────────────────────────────────────────────────────
# One of these, or none and run `claude` once inside the container to sign in with a subscription.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Bedrock or Vertex instead: CLAUDE_CODE_USE_BEDROCK=1 and the AWS_* variables, as for the engine.

# ── Code host ─────────────────────────────────────────────────────────────────
# Fine-grained token: Contents read, Issues read, Pull requests read (the agent) or write (posting).
GITHUB_TOKEN=
GITLAB_TOKEN=

# ── Atlassian (Jira, Confluence) ──────────────────────────────────────────────
# An API token from id.atlassian.com for the email below. The same token works for Jira, Confluence and the
# Atlassian MCP server (an Atlassian admin must enable API-token auth for the MCP server).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
CONFLUENCE_BASE_URL=
CONFLUENCE_TOKEN=

# ── TestRail ──────────────────────────────────────────────────────────────────
TESTRAIL_URL=
TESTRAIL_USERNAME=
TESTRAIL_API_KEY=

# ── Figma ─────────────────────────────────────────────────────────────────────
# Only for mcp.figma.mode "remote". With "desktop", the Figma app on your machine serves the design; nothing here.
FIGMA_TOKEN=

# ── Chat ──────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
TEAMS_WEBHOOK_URL=

# ── The kit itself ────────────────────────────────────────────────────────────
# Kill switch for every agent. "false" stops them all.
CO_AGENTS_ENABLED=true
# The repository the agents read, on the host. Default: the repository this compose file is in.
# Mac:     CO_WORKDIR=/Users/you/code/shop        Windows: CO_WORKDIR=C:/Users/you/code/shop  (forward slashes)
CO_WORKDIR=
# Pin before real use.
CLAUDE_CODE_VERSION=latest
GITHUB_MCP_VERSION=latest
