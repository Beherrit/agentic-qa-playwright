{
  "name": "agentic-qa-playwright",
  "version": "1.0.0",
  "description": "An agentic QA pipeline on GitHub Actions: a Jira or GitHub ticket in, a QA analysis and reviewed Playwright tests out, with a person merging the pull request.",
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test agents/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "report": "playwright show-report",
    "pipeline": "tsx agents/cli.ts",
    "triage": "tsx agents/triage.ts",
    "coverage": "tsx agents/coverage.ts",
    "doctor": "tsx agents/cli.ts doctor",
    "draft": "tsx agents/cli.ts draft",
    "heal": "tsx agents/heal.ts",
    "history": "tsx agents/history.ts",
    "mcp": "tsx agents/mcp.ts"
  },
  "author": "Lawrence Moran",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "zod": "^4.6.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  }
}
